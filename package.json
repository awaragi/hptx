{
  "name": "hptx",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Reusable HTML presentation platform: decks of standalone slide HTML files assembled into a single-file presentation.",
  "author": "Pierre Awaragi <pierre@awaragi.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/awaragi/hptx.git"
  },
  "homepage": "https://github.com/awaragi/hptx#readme",
  "bugs": {
    "url": "https://github.com/awaragi/hptx/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "hptx": "bin/hptx.js"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts dev",
    "build": "tsx src/cli/main.ts build",
    "new": "tsx src/cli/main.ts new",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "node scripts/link-local-bin.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "commander": "^15.1.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "postcss-selector-parser": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "presentation",
    "slides",
    "deck",
    "html",
    "css",
    "javascript",
    "cli"
  ],
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
